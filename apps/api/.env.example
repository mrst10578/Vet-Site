# Database credentials are server-side secrets. Never use real patient data in demos.
DATABASE_URL=postgres://vetuser:change_me@127.0.0.1:5432/vetcare
DATABASE_SSL=false
API_PORT=4000
API_HOST=127.0.0.1
# Exact origin of the browser application; mandatory for cookie-backed mutation routes
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
# At least 32 random chars, required for OTP HMAC
OTP_PEPPER=replace-with-32-or-more-cryptographically-random-characters
# Generic SMS HTTP adapter. This URL must be set to a trusted sender (POST {to,message}).
SMS_ENDPOINT_URL=
SMS_BEARER_TOKEN=
